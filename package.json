{
  "name": "dsh-kit",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness (DSH) 傻瓜式插件全家桶 - 装一个包，所有功能开箱即用",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:client": "node scripts/build-client-once.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "tsx scripts/dev-web.ts --poll",
    "add": "dsh plugin --profile web add -w"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.11.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
