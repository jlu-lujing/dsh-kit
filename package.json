{
  "name": "dsh-studio",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Studio —— 基于 DSH (dsh) 定制的桌面助手全家桶（单包）",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:client": "node scripts/build-client-once.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "tsx scripts/dev.ts",
    "add": "dsh plugin --profile web add -w"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.11.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
